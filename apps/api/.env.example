NODE_ENV=production
PORT=4000
API_PORT=4000

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
REDIS_URL=redis://default:PASSWORD@HOST:PORT

JWT_SECRET=replace-with-strong-secret
ACCESS_TOKEN_SECRET=replace-with-strong-access-token-secret
REFRESH_TOKEN_SECRET=replace-with-strong-refresh-token-secret
MFA_CHALLENGE_SECRET=replace-with-strong-mfa-secret

ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
REFRESH_TOKEN_COOKIE_MAX_AGE_MS=604800000

CORS_ORIGINS=https://your-web-url.com
FRONTEND_URL=https://your-web-url.com

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
