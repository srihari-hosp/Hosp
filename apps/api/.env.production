# --- FINAL PRODUCTION ENVIRONMENT VARIABLES ---
# Copy these values into your Railway Dashboard (hosp-api service)

# 1. Environment
NODE_ENV=production
PORT=3001

# 2. Database (Neon)
DATABASE_URL=postgresql://your_neon_user:your_password@your_neon_host/hms_db?sslmode=require

# 3. Redis (Railway)
# Use the internal variable from your Redis service:
REDIS_URL=rediss://default:ASaBAAImcDE4ZTMyZGRjNjg1MmI0YTZmYWIwNDI5ODg4ODA5MzNkM3AxOTg1Nw@willing-orca-9857.upstash.io:6379
BULLMQ_REDIS_URL=rediss://default:ASaBAAImcDE4ZTMyZGRjNjg1MmI0YTZmYWIwNDI5ODg4ODA5MzNkM3AxOTg1Nw@willing-orca-9857.upstash.io:6379

# 4. Security
# Replace these with long random strings
JWT_SECRET=your_production_secret_key_random_64_chars
JWT_REFRESH_SECRET=your_production_refresh_key_random_64_chars

# 5. CORS & Frontend
# Update this with your actual Vercel URL
FRONTEND_URL=https://hosp-production-your-app.vercel.app
ALLOWED_ORIGINS=https://hosp-production-your-app.vercel.app,http://localhost:3000
