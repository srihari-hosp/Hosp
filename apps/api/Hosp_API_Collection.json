							"mode": "raw",
							"raw": "{\n    \"hospitalName\": \"City General Hospital\",\n    \"address\": \"123 Medical Square, Bangalore\",\n    \"phone\": \"+919876543210\",\n    \"email\": \"{{admin_email}}\",\n    \"password\": \"{{admin_password}}\",\n    \"licenseNo\": \"HOSP-BGL-001\",\n    \"gstin\": \"29AAAAA0000A1Z5\"\n}",
							"options": {
								"raw": {
