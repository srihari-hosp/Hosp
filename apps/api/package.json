{
  "name": "@hosp/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx prisma generate --schema src/prisma/schema.prisma && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "worker:pdf": "tsx src/workers/startPdfWorker.ts",
    "worker:invoice-pdf": "tsx src/workers/startInvoicePdfWorker.ts",
    "worker:notifications": "tsx src/workers/startNotificationsWorker.ts",
    "worker:data-archival": "tsx src/workers/startDataArchivalWorker.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "build": "npx prisma generate --schema src/prisma/schema.prisma && tsc -p tsconfig.json",
    "seed": "tsx src/prisma/seed.ts",
    "prisma:generate": "node -r dotenv/config ../../node_modules/prisma/build/index.js generate --schema src/prisma/schema.prisma dotenv_config_path=./.env",
    "prisma:migrate:deploy": "node -r dotenv/config ../../node_modules/prisma/build/index.js migrate deploy --schema src/prisma/schema.prisma dotenv_config_path=./.env",
    "prisma:studio": "node -r dotenv/config ../../node_modules/prisma/build/index.js studio --schema src/prisma/schema.prisma dotenv_config_path=./.env",
    "test": "vitest run",
    "test:security": "vitest run src/__tests__/security.owasp.test.ts",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:full": "npm run security:audit && npm run test:security",
    "perf:latency": "node scripts/perf/latency-sla-check.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.1",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.3",
    "bullmq": "^5.61.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "otpauth": "^9.5.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.17.19",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.19.1",
    "supertest": "^7.1.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  }
}
